<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>HideCornerIcons</AssemblyName>
    <RootNamespace>HideCornerIcons</RootNamespace>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <DebugType>pdbonly</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- PrivateAssets/ExcludeAssets keep Blish HUD's own assemblies out of the output (Copy Local = false). -->
    <PackageReference Include="BlishHUD" Version="*-*" ExcludeAssets="runtime" PrivateAssets="all" />
    <Reference Include="System.ComponentModel.Composition" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="logo.png" LogicalName="logo.png" />
  </ItemGroup>

  <ItemGroup>
    <None Update="manifest.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
